APP_ENV=demo
DEMO_MODE=true
DATABASE_URL=postgresql+psycopg://bytecode:bytecode_local_demo@postgres:5432/bytecode
POSTGRES_USER=bytecode
POSTGRES_PASSWORD=bytecode_local_demo
POSTGRES_DB=bytecode
MOCK_GOV_API_URL=http://mock-gov-api:8001
QDRANT_URL=http://qdrant:6333
JWT_SECRET=
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
OCR_PROVIDER=paddle
VECTOR_PROVIDER=qdrant
ENABLE_HEAVY_ML=false
MATCH_THRESHOLD=0.95
REVIEW_THRESHOLD=0.80
UPLOAD_MAX_MB=15

# Optional host-port overrides for laptops already running other projects.
FRONTEND_PORT=3000
BACKEND_PORT=8000
MOCK_GOV_PORT=8001
POSTGRES_PORT=5432
QDRANT_PORT=6333

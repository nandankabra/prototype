e].id && <code>{lineage[node].id}</code>}</div>{node===0&&doc&&<button className="button" onClick={()=>onDocument(doc)}><FileText size={16}/> Open original</button>}{node===6&&canDecide&&<button className="button primary" onClick={onDecide}>Record decision <ArrowRight size={16}/></button>}</div></Panel>{review.ai && <RecommendationPanel review={review} onDecide={onDecide} canDecide={canDecide}/>}</div>;
}

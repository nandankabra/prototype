export function RecommendationPanel({review, onDecide, canDecide}: {review: Review; onDecide:()=>void; canDecide:boolean}) {
  if(!review.ai) return <Empty title="AI explanation pending">The explanation is generated after source, rule, and risk checks finish.</Empty>;

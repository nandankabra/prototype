v></div><div className="chart-legend">{data.risk_distribution.filter(d=>d.value || d.name!=='UNASSESSED').map(d=><div key={d.name}><span className="legend-dot" style={{background:COLORS[d.name]}}/>{d.name.toLowerCase()}<strong>{d.value}</strong></div>)}</div></div><div className="chart-caption"><ShieldAlert size={14}/> {data.issues_detected} evidence-backed findings</div></Panel></div><div className="dashboard-lower"><Panel title="Officer review queue" subtitle="Highest-risk unresolved applications appear first" action={<Link className="text-button" to="/bids">View all applications <ArrowUpRight size={15}/></Link>}><BidTable bids={data.priority_bids} compact/></Panel><Panel title="Recent activity" subtitle="Every action leaves an evidence trail" action={<Link to="/audit" className="icon-button" aria-label="Open audit trail"><ArrowUpRight size={18}/></Link>}><div className="activity-list">{data.recent_events.slice(0,5).map(e=><div className="activity" key={e.id}><span className="activity-icon"><ShieldCheck size={15}/></span><div><strong>{e.action.toLowerCase().replaceAll('_',' ')}</strong><p>{e.actor}</p><small>{dateTime(e.created_at)}</small></div></div>)}</div><div className="integrity-strip"><ShieldCheck size={15}/> Audit integrity <Badge value={data.integrity.status}/></div></Panel></div><div className="secondary-charts"><Panel title="Verification-provider status" subtitle="Each outcome retains its actual method and source"><div className="source-counts">{data.verification_status.map(s=><div key={s.name}><Badge value={s.name}/><strong>{s.value}</strong></div>)}</div></Panel><Panel title="Review throughput" subtitle="Officer decisions recorded per day">{data.review_throughput.length ? <div className="chart-wrap"><ResponsiveContainer width="100%" height={160}><BarChart data={data.review_throughput}><XAxis dataKey="name" tickLine={false} axisLine={false}/><YAxis allowDecimals={false} tickLine={false} axisLine={false}/><Tooltip/><Bar dataKey="value" fill="#168986" maxBarSize={40} radius={[4,4,0,0]}/></BarChart></ResponsiveContainer></div> : <div className="throughput-empty"><ClipboardCheck size={25}/><p>Officer decisions will appear here.</p><Link to="/bids">Open review queue <ArrowRight size={14}/></Link></div>}</Panel></div></>;
}

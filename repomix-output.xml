)}</div><section role="tabpanel">{tab==='Evidence Intelligence'&&<EvidenceIntelligence review={review} onDocument={setView} onDecide={()=>setDecide(true)} canDecide={canDecide}/>} {tab==='Company Profile'&&<div className="two-col"><Panel title="Registered bidder profile" subtitle="Declared bidder identity"><div className="content-pad">{[['Company name',review.bidder.name],['PAN',review.bidder.pan],['GSTIN',review.bidder.gstin],['Udyam',review.bidder.udyam],['Address',review.bidder.address]].map(([k,v])=><div className="label-value" key={k}><span>{k}</span><strong>{v}</strong></div>)}</div></Panel><Panel title="Review context"><div className="content-pad"><div className="label-value"><span>Tender</span><strong>{review.tender.reference}</strong></div><div className="label-value"><span>Submission deadline</span><strong>{dateTime(review.tender.deadline)}</strong></div><div className="label-value"><span>Documents</span><strong>{review.documents.length}</strong></div><div className="label-value"><span>Latest processing run</span><Badge value={review.run?.status}/></div><p className="inline-notice section-gap">Source comparisons are performed against fictional demo records. Registered profile values are not proof of documentary compliance.</p></div></Panel></div>}{tab==='Documents'&&<div className="stack">{canEdit&&<div className={`upload-zone ${drag?'dragging':''}`} onDragOver={e=>{e.preventDefault();setDrag(true);}} onDragLeave={()=>setDrag(false)} onDrop={e=>{e.preventDefault();setDrag(false);if(!processing&&!uploading)void upload(e.dataTransfer.files);}}><UploadCloud size={31}/><h3>Upload bidder documents</h3><p>Drop PDF, PNG, or JPG files here. Up to {import.meta.env.VITE_UPLOAD_MAX_MB || 15} MB each.</p><input ref={fileInput} type="file" multiple accept=".pdf,.png,.jpg,.jpeg" hidden onChange={e=>void upload(e.target.files)}/><button className="button" onClick={()=>fileInput.current?.click()} disabled={processing||uploading}>{uploading?'Uploading…':'Choose documents'}</button><small>Uploads trigger a new review and preserve earlier evidence and decisions.</small></div>}<Panel title="Submitted documents" subtitle="Open an original to inspect extracted fields and source evidence"><div className="table-scroll"><table><thead><tr><th>Document</th><th>Classification</th><th>Extraction</th><th>Fields</th><th>Original</th></tr></thead><tbody>{review.documents.map(d=><tr key={d.id}><td><div className="doc-name"><FileText size={19}/><div><strong>{d.filename}</strong><small>{d.is_seed?'Fictional sample':'Officer upload'}</small></div></div></td><td>{pretty(d.classification)}</td><td>{d.extraction.ocr_confidence!==undefined?percent(d.extraction.ocr_confidence):'Awaiting processing'}<small className="block-small">{d.extraction.providers?.join(', ')}</small></td><td>{review.entities.filter(e=>e.document_id===d.id).length}</td><td><button className="text-button" onClick={()=>setView(d)}>Inspect <ArrowRight size={14}/></button></td></tr>)}</tbody></table></div></Panel></div>}{tab==='Government Verification'&&<SourceVerificationTable review={review} onDocument={setView}/>} {tab==='Tender Compliance'&&<ComplianceMatrix review={review} onDocument={setView}/>} {tab==='Risk Analysis'&&<RiskAnalysis review={review}/>} {tab==='AI Recommendation'&&<RecommendationPanel review={review} canDecide={canDecide} onDecide={()=>setDecide(true)}/>} {tab==='Audit Trail'&&<AuditTrail bidId={review.id} embedded/>}</section>{view&&<DocumentViewer document={review.documents.find(d=>d.id===view.id)||view} review={review} onClose={()=>setView(null)}/>} {decide&&<OfficerDecisionModal review={review} onClose={()=>setDecide(false)} onSaved={()=>void reload()}/>}</>;
}

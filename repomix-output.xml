  const ev=signal?.evidence[0]||rule?.evidence[0];
  const verification=review.verifications.find(v=>v.id===ev?.verification_id);
  const entity=review.entities.find(e=>e.id===(ev?.entity_id || verification?.entity_id));
  const doc=review.documents.find(d=>d.id===(ev?.document_id || entity?.document_id || verification?.evidence.document_id));
  const decision=review.decisions.find(d=>d.run_id===review.current_run_id);
  const lineage=[{title:'Document',value:doc?.filename || (signal?.type==='missing_mandatory_document'?'Missing document':'Document set'),id:doc?.id,icon:FileText},
    {title:'Extracted entity',value:entity?.value || 'Document presence / validity',id:entity?.id,icon:Fingerprint},
    {title:'Source check',value:verification?`${verification.source} · ${pretty(verification.status)}`:'Documentary rule check',id:verification?.id,icon:ShieldCheck},
    {title:'Tender rule',value:rule?`${rule.rule_code} · ${pretty(rule.status)}`:'Cross-document anomaly',id:rule?.result_id,icon:CheckCircle2},
    {title:'Risk signal',value:signal?`+${signal.points} risk points`:'No rule-based risk',id:signal?.id,icon:AlertTriangle},
    {title:'AI explanation',value:review.ai?.recommended_action || 'Pending',id:review.ai?.id,icon:Sparkles},
    {title:'Officer decision',value:decision?.decision || 'Awaiting officer',id:decision?.id,icon:UserCheck}];

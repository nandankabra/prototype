<file path="frontend/Dockerfile">
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build
FROM nginx:alpine@sha256:72ba65eb42c10344912a84ff42408db7d34f2feb642204570ab8fc5ffd29f1d3
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
</file>

<file path="frontend/index.html">
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><meta name="description" content="ByteCode Verify - evidence-backed bid compliance decision support. Local demonstration using mock authorised sources."/><meta name="theme-color" content="#101f35"/><title>ByteCode Verify | Bid Compliance Workspace</title></head><body><div id="root"></div><script type="module" src="/src/main.tsx"></script></body></html>
</file>

<file path="frontend/nginx.conf">
server {
  listen 80;
  root /usr/share/nginx/html;
  client_max_body_size 16m;
  location /api/ { proxy_pass http://backend:8000; proxy_read_timeout 120s; }
  location / { try_files $uri $uri/ /index.html; }
}
</file>


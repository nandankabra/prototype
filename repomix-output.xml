import { download, fileBlob, post } from '../services/api';
import { Badge, Empty, ErrorBox, Modal, SourceStatus, Panel, dateTime, percent, pretty } from './ui';

export function ScoreCards({ review }: {review: Review}) {
  const verified = review.verifications.filter(v=>v.status==='VERIFIED').length;
  return <div className="review-score-grid"><div className="review-score-card"><span className="score-card-label">Compliance score <ShieldCheck size={17}/></span><div><strong>{review.compliance_score ?? '—'}</strong><span>/ 100</span></div><div className="wide-track"><span style={{width:`${review.compliance_score || 0}%`}}/></div><p>Weighted, evidence-backed assessment</p></div><div className="review-score-card risk-score"><span className="score-card-label">Risk assessment <AlertTriangle size={17}/></span><div><strong>{review.risk_score ?? '—'}</strong><span>/ 100</span><Badge value={review.risk_level}/></div><p>{review.risk?.contributing_factors.length || 0} contributing risk signals</p></div><div className="review-score-card"><span className="score-card-label">Source verification <Fingerprint size={17}/></span><div><strong>{verified}</strong><span>/ {review.verifications.length || 11}</span></div><p>{review.verifications.length-verified} checks need officer attention</p><SourceStatus/></div></div>;
}

export function SourceVerificationTable({ review, onDocument }: {review: Review; onDocument: (doc: DocumentRecord)=>void}) {
  const [source, setSource] = useState('ALL');
  return <Panel title="Authorised-source verification" subtitle="Submitted identifiers compared with fictional source records" action={<SourceStatus/>}><div className="toolbar"><select aria-label="Filter source checks" value={source} onChange={e=>setSource(e.target.value)}><option value="ALL">All source checks</option><option value="ATTENTION">Needs attention</option><option value="VERIFIED">Demo verified</option></select><span className="toolbar-count">{review.verifications.length} source records</span></div>{!review.verifications.length ? <Empty title="Source checks have not run">Start an AI compliance review to verify extracted identifiers.</Empty> : <div className="table-scroll"><table className="verification-table"><thead><tr><th>Source</th><th>Extracted value</th><th>Source record</th><th>Status</th><th>Confidence</th><th>Evidence</th></tr></thead><tbody>{review.verifications.filter(v=>source==='ALL'||(source==='VERIFIED'?v.status==='VERIFIED':v.status!=='VERIFIED')).map(v=>{const doc=review.documents.find(d=>d.id===v.evidence.document_id);return <tr key={v.id} className={v.status==='MISMATCH'?'flagged-row':''}><td><strong>{pretty(v.source)}</strong><small className="block-small">{dateTime(v.checked_at)}</small></td><td><code className={v.status==='MISMATCH'?'field-mismatch':''}>{v.identifier || 'Not extracted'}</code></td><td><code>{v.evidence.source_value || 'Not available'}</code><small className="block-small">{String(v.record.status || 'No source record')}</small></td><td><Badge value={v.status}/></td><td>{percent(v.confidence)}</td><td><details className="evidence-details"><summary>Inspect</summary><p>{v.evidence.reason}</p><code>{v.id}</code>{doc && <button className="text-button" onClick={()=>onDocument(doc)}><FileText size={14}/> Open page {v.evidence.source_page || 1}</button>}</details></td></tr>;})}</tbody></table></div>}</Panel>;
}

export function ComplianceMatrix({ review, onDocument }: {review: Review; onDocument: (doc: DocumentRecord)=>void}) {
  return <div className="stack"><Panel title="Tender compliance matrix" subtitle={`${review.compliance.filter(r=>r.status==='PASS').length} of ${review.compliance.length} enabled rules passed`}><div className="rule-list">{review.compliance.map(r=><details className="rule-result" key={r.result_id}><summary><span className={`rule-icon ${r.status==='PASS'?'pass':'fail'}`}>{r.status==='PASS'?<CheckCircle2 size={18}/>:<AlertTriangle size={18}/>}</span><span><small>{r.rule_code} · {pretty(r.category)}</small><strong>{r.name}</strong></span><Badge value={r.status}/></summary><div className="rule-evidence"><p>{r.explanation}</p><div className="evidence-tag">{r.required?'Mandatory':'Advisory'} · {pretty(r.severity)} severity</div>{r.evidence.map((e,i)=>{const doc=review.documents.find(d=>d.id===e.document_id)||review.documents.find(d=>d.id===review.entities.find(x=>x.id===e.entity_id)?.document_id); return <div key={i} className="rule-evidence-item"><code>{e.extracted || e.filename || e.status || e.source || 'Evidence record'}</code>{e.source_value && <span>Source: <code>{e.source_value}</code></span>}{doc && <button className="text-button" onClick={()=>onDocument(doc)}>Open {doc.filename} <ArrowRight size={13}/></button>}</div>;})}<small className="subtle">Rule result: {r.result_id}</small></div></details>)}</div></Panel>{review.risk && <Panel title="How the compliance score is calculated" subtitle={review.risk.compliance.method}><div className="score-breakdown">{review.risk.compliance.breakdown.map(part=><details key={part.component}><summary><span>{part.component}<small>{part.passed} / {part.total} checks</small></span><div className="breakdown-track"><i style={{width:`${part.weight ? part.earned/part.weight*100 : 0}%`}}/></div><strong>{part.earned}<small> / {part.weight}</small></strong></summary><ul>{part.evidence.map((text,i)=><li key={i}>{text}</li>)}</ul></details>)}</div></Panel>}</div>;
}

export function RiskAnalysis({review}: {review: Review}) {
  if(!review.risk) return <Empty title="Risk assessment pending">Start a verification run to calculate risk from evidence.</Empty>;
  return <div className="stack"><Panel title="Contributing risk signals" subtitle={review.risk.method}><div className="risk-signals">{review.risk.contributing_factors.length ? review.risk.contributing_factors.map(s=><div className="risk-signal" key={s.id}><AlertTriangle size={20}/><div><strong>{pretty(s.type)}</strong><p>{s.description}</p><small>{s.rule_result_ids.length} linked tender rule result(s)</small></div><b>+{s.points}<small>risk points</small></b></div>):<Empty title="No rule-based risk signals">All configured checks passed for this run.</Empty>}</div></Panel><div className="two-col"><Panel title="Identity consistency" subtitle="Name and identifier matching with explicit thresholds"><div className="content-pad">{review.risk.identity_checks.map(c=><div className="identity-check" key={c.label}><div><strong>{c.label}</strong><Badge value={c.status}/></div>{c.left && <p>{c.left}<br/><span>Source: {c.right}</span></p>}{c.similarity!==undefined && <small>{percent(c.similarity)} similarity · {c.provider}</small>}</div>)}<p className="subtle">Default thresholds: match ≥95%; review 80–95%; mismatch &lt;80%.</p></div></Panel><Panel title="Anomaly analysis" subtitle={review.risk.anomaly.detector}><div className="content-pad"><div className="anomaly-number">{review.risk.anomaly.anomaly_score ?? '—'}<span>model anomaly score</span></div><p className="subtle">{review.risk.anomaly.explanation}</p><details className="feature-details"><summary>Inspect detector features</summary>{Object.entries(review.risk.anomaly.features).map(([k,v])=><div className="label-value" key={k}><span>{pretty(k)}</span><strong>{typeof v==='number'?Math.round(v*100)/100:v}</strong></div>)}</details></div></Panel></div></div>;
